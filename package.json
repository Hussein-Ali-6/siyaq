{
  "name": "siyaq",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "Understand English words and sentences in context, with translation into your language, powered by the AI model you choose.",
  "scripts": {
    "dev": "wxt",
    "build": "wxt build",
    "zip": "wxt zip",
