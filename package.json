    "@openrouter/ai-sdk-provider": "3.1.0",
    "@webext-core/messaging": "^4.0.0",
    "ai": "7.0.138",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/chrome": "^0.3.5",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "@wxt-dev/module-react": "^1.2.2",
    "jsdom": "^30.1.2",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "5.9.3",
    "vite": "^7.3.7",
    "vitest": "^5.0.4",
    "wxt": "^0.21.4"
  }
